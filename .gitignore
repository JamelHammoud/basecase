# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Benchmark downloads and run outputs
bench/data/
bench/runs/

# Copies of folders attached to the agent (can be large)
/library/evidence/

# Manufacturer CAD downloads (large; source URLs are in tools/parts/sources.json)
tools/parts/cad/
tools/parts/generated/*.log

# Local app data: saved scenes, chats, uploads, prices, and the agent's workspace sync
/library/
/ai-reference/

# Policy trainer virtualenv (uv creates it in library/trainer-env; this is a dev fallback)
electron/trainer/.venv/
electron/simready/.venv/

# Python bytecode
__pycache__/

# Secrets and per-machine settings
.env
.env.*
.claude/settings.local.json
.claude/launch.json

# Tool caches
.ruff_cache/

# Scratch work: throwaway scripts, debug tests, one-off outputs (see AGENTS.md §0g)
/scratch/

# Internal notes: research, plans, chat analyses and design explorations that aren't for contributors (see AGENTS.md §0g)
/internal/

# Bambu Studio CLI writes this into its working folder
/result.json

# Native addon build output (npm run native)
electron/native/*/build/
