{
  "name": "basecase",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "vite build && node tools/electron-dev.mjs . --bundle",
    "dev": "vite --port 5173",
    "electron": "node tools/electron-dev.mjs .",
    "electron:dev": "node tools/electron-hmr.mjs",
    "build": "tsc -b && vite build",
    "dev:web": "vite --port 5174 --mode web",
    "build:web": "tsc -b && vite build --mode web",
    "dev:site": "vite --config site/vite.config.ts --port 5175",
    "build:site": "vite build --config site/vite.config.ts",
    "preview": "vite preview",
    "check": "npm run check:tracked && npm run check:docs && npm run format:check && npm run lint && npm run lint:py && npm run typecheck && npm test",
    "check:tracked": "node tools/check-tracked.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "scratch": "vitest run --config vitest.scratch.config.ts",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "parts:contributed": "node tools/parts/list-contributed.mjs",
    "perf:agent": "node tools/perf/agentBench.mjs",
    "perf:viewport": "node tools/perf/viewportBench.mjs",
    "perf:gallery": "node tools/perf/galleryBench.mjs",
    "gallery": "node tools/gallery/build.mjs",
    "icon": "xcrun actool \"$PWD/build/icon/Basecase.icon\" --compile \"$PWD/build/icon/compiled\" --platform macosx --minimum-deployment-target 26.0 --app-icon Basecase --target-device mac --output-partial-info-plist \"$PWD/build/icon/compiled/partial.plist\" --output-format human-readable-text",
    "icon:dev": "xcrun actool \"$PWD/build/icon/BasecaseDev.icon\" --compile \"$PWD/build/icon/compiled-dev\" --platform macosx --minimum-deployment-target 26.0 --app-icon BasecaseDev --target-device mac --output-partial-info-plist \"$PWD/build/icon/compiled-dev/partial.plist\" --output-format human-readable-text",
    "icons": "node tools/icons/emit.mjs && prettier --write src/design-system/glyphs",
    "prepare": "simple-git-hooks && node tools/native/build.mjs",
    "native": "node tools/native/build.mjs",
    "lint:py": "uvx ruff check . && uvx ruff format --check .",
    "recipes:harvest": "node tools/recipes/harvest.mjs",
    "security": "node tools/security/audit.mjs",
    "dist": "vite build && npm run build:forge && npm run build:daemon && electron-builder --mac --arm64 --publish never",
    "dist:win": "vite build && npm run build:forge && npm run build:daemon && electron-builder --win --x64 --publish never",
    "build:forge": "cargo build --release --manifest-path forge/Cargo.toml -p forge-train && node tools/forge/stage.mjs",
    "build:daemon": "cargo build --release --manifest-path hw/Cargo.toml -p robot-daemon && node tools/hw/stage.mjs",
    "test:app": "vitest run --config vitest.app.config.ts",
    "verify": "node verify/gatekeeper.mjs",
    "build:contract": "node tools/build-contract.mjs",
    "build:routines": "node hw/coordinator/build-wasm.mjs",
    "build:forge-web": "node tools/forge/build-web.mjs",
    "check:routines": "node hw/coordinator/build-wasm.mjs --check"
  },
  "build": {
    "appId": "app.basecase",
    "productName": "Basecase",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "dist/**",
      "vendor/**",
      "electron/**",
      "!electron/**/*.test.mjs",
      "!electron/**/.venv/**",
      "!electron/**/__pycache__/**",
      "!electron/native/*/build/**",
      "electron/native/*/build/Release/*.node",
      "!electron/vite-bridge-middleware.mjs",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/@openai/codex-*/**",
      "!node_modules/@google/gemini-cli/**",
      "!electron/cad-kernel/nodeHost/**",
      "!electron/cadImport/nodeHost/**",
      "!node_modules/occt-import-js/**",
      "!node_modules/openscad-wasm/**",
      "!node_modules/replicad/**",
      "!node_modules/replicad-opencascadejs/**",
      "!node_modules/three/src/**",
      "package.json"
    ],
    "electronLanguages": [
      "en",
      "en-US",
      "en_GB",
      "en-GB"
    ],
    "afterPack": "tools/release/afterPack.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "JamelHammoud",
        "repo": "basecase"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon/compiled/Basecase.icns",
      "hardenedRuntime": true,
      "forceCodeSigning": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/icon/compiled/Assets.car",
          "to": "Assets.car"
        },
        {
          "from": "forge/dist",
          "to": "forge"
        },
        {
          "from": "hw/dist",
          "to": "hw"
        }
      ],
      "extendInfo": {
        "CFBundleIconName": "Basecase",
        "NSLocalNetworkUsageDescription": "So Basecase can find your printers and send them prints.",
        "NSBonjourServices": [
          "_octoprint._tcp",
          "_moonraker._tcp"
        ]
      }
    },
    "dmg": {
      "artifactName": "Basecase.dmg",
      "title": "Basecase"
    },
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm",
        "filter": [
          "libs/fflate.module.js"
        ]
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "win": {
      "signExts": [
        ".dll"
      ],
      "extraResources": [
        {
          "from": "forge/dist",
          "to": "forge"
        },
        {
          "from": "hw/dist",
          "to": "hw"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon/basecase-1024.png"
    },
    "nsis": {
      "artifactName": "Basecase-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Basecase",
      "uninstallDisplayName": "Basecase",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.99.1",
    "@agentclientprotocol/codex-acp": "^2.5.0",
    "@agentclientprotocol/sdk": "^1.8.0",
    "@google/gemini-cli": "^0.66.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.10",
    "meshoptimizer": "^1.3.0",
    "occt-import-js": "^0.0.23",
    "openscad-wasm": "^0.0.4",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@babel/core": "^7.29.7",
    "@dagrejs/dagre": "^3.1.3",
    "@eslint/js": "^10.0.1",
    "@mujoco/mujoco": "4.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.1",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.17.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "lint-staged": "^17.6.0",
    "manifold-3d": "^3.5.4",
    "node-gyp": "^13.1.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "three-bvh-csg": "^0.0.18",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && node tools/check-tracked.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,css,html}": "prettier --write",
    "*.py": [
      "uvx ruff format",
      "uvx ruff check --fix"
    ]
  },
  "allowScripts": {
    "simple-git-hooks": true,
    "fsevents": false,
    "node-pty": false,
    "@github/keytar": false,
    "electron-winstaller": false
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "productName": "Basecase"
}
